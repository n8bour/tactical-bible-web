{
  "name": "tactical-bible-web",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm -w packages/sim run build && npm -w apps/web run build",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p packages/sim && tsc -p packages/content && npm -w apps/web run check",
    "seed:content": "node packages/content/scripts/seed-mdx.mjs",
    "draft:profiles": "node packages/content/scripts/draft-profiles.mjs",
    "tuning:report": "vitest run --config packages/content/scripts/vitest.tuning.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
