---
import { getCollection, render } from 'astro:content';
import { TI_EFFECTS, teamInstructions } from '@tb/content';
import Base from '../../../layouts/Base.astro';
import PitchLab from '../../../lab/PitchLab';
import { BASE, href, PHASE_NAME } from '../../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('team-instructions');
  return entries.map((entry) => ({ params: { key: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
const t = entry.data;
const data = teamInstructions.find((x) => x.key === t.key)!;
const { Content } = await render(entry);
const effect = TI_EFFECTS[t.key](data.default);
---
<Base title={t.name} description={t.summary}>
  <p><a href={href('/instructions')}>← Instructions</a></p>
  <h1>{t.name}</h1>
  <p>
    <span class="badge" data-phase>{PHASE_NAME[data.phase]}</span>
    <span class="badge" data-src={effect.src}>Effect {effect.src.toUpperCase()}</span>
    {data.fm27 && <span class="badge" data-phase>New in FM27</span>}
    {data.unconf && <span class="badge" data-src="est">Options unconfirmed</span>}
  </p>
  <p class="lead">{t.summary}</p>
  <p>Options: {data.options.map((o, i) => <span>{i ? ' · ' : ''}{i === data.default ? <strong>{o} (default)</strong> : o}</span>)}</p>
  {t.scenes.map((id) => <PitchLab client:visible sceneId={id} base={BASE} />)}
  <div class="prose">
    <Content />
    <h2>How the simulation applies it</h2>
    <p>{effect.note}</p>
  </div>
</Base>
