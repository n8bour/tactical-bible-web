---
import { getCollection, render } from 'astro:content';
import { PI_EFFECTS } from '@tb/content';
import type { PIKey } from '@tb/sim';
import Base from '../../../layouts/Base.astro';
import PitchLab from '../../../lab/PitchLab';
import { BASE, href } from '../../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('player-instructions');
  return entries.map((entry) => ({ params: { key: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const effect = PI_EFFECTS[p.key as PIKey];
---
<Base title={p.name} description={p.summary}>
  <p><a href={href('/instructions')}>← Instructions</a></p>
  <h1>{p.name}</h1>
  <p>
    <span class="badge" data-src={effect.src}>Effect {effect.src.toUpperCase()}</span>
    {p.fm27 && <span class="badge" data-phase>New in FM27</span>}
  </p>
  <p class="lead">{p.summary}</p>
  {p.scenes.map((id) => <PitchLab client:visible sceneId={id} base={BASE} />)}
  <div class="prose">
    <Content />
    <h2>How the simulation applies it</h2>
    <p>{effect.note}</p>
  </div>
</Base>
