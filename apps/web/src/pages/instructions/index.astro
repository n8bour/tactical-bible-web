---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, PHASE_NAME } from '../../lib/site';

const team = (await getCollection('team-instructions')).map((e) => e.data);
const player = (await getCollection('player-instructions')).map((e) => e.data);
---
<Base title="Instructions">
  <h1>Instructions</h1>
  {(['IP', 'OOP'] as const).map((ph) => (
    <section>
      <h2>Team instructions: {PHASE_NAME[ph].toLowerCase()}</h2>
      <ul class="cards" role="list">
        {team.filter((t) => t.phase === ph).map((t) => (
          <li><a class="card" href={href(`/instructions/team/${t.key}`)}><h3>{t.name}</h3><p>{t.summary}</p></a></li>
        ))}
      </ul>
    </section>
  ))}
  <h2>Player instructions</h2>
  <ul class="cards" role="list">
    {player.map((p) => (
      <li><a class="card" href={href(`/instructions/player/${p.key}`)}><h3>{p.name}</h3><p>{p.summary}</p></a></li>
    ))}
  </ul>
</Base>
