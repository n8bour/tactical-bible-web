---
import Base from '../layouts/Base.astro';
import TacticsBoard from '../lab/TacticsBoard';
import { BASE } from '../lib/site';
---
<Base title="Tactics board" description="Pick your shape, the opponent's and every team instruction, then watch your team attack and defend.">
  <h1>Tactics board</h1>
  <p class="lead">Choose your shapes with and without the ball, the opponent, and your team instructions. <strong>In possession</strong> shows your team building from the keeper and attacking; <strong>Out of possession</strong> shows the opponent attacking your block.</p>
  <TacticsBoard client:only="react" base={BASE} />
</Base>
