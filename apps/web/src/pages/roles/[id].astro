---
import { getCollection, render } from 'astro:content';
import { ROLE_PROFILES } from '@tb/content';
import Base from '../../layouts/Base.astro';
import AttrModel from '../../components/AttrModel.astro';
import RoleExplorer from '../../lab/RoleExplorer';
import { ATTR_NAME, BASE, GROUP_NAME, href, PHASE_NAME } from '../../lib/site';

export async function getStaticPaths() {
  const roles = await getCollection('roles');
  return roles.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}
const { entry } = Astro.props;
const r = entry.data;
const { Content } = await render(entry);
const profile = ROLE_PROFILES[r.id];
---
<Base title={r.name} description={r.summary}>
  <p><a href={href('/roles')}>← Roles</a></p>
  <h1>{r.name} <span class="badge" data-phase>{r.ab}</span></h1>
  <p>
    <span class="badge" data-phase>{PHASE_NAME[r.phase]}</span>
    {r.groups.map((g) => <span class="badge" data-phase>{GROUP_NAME[g] ?? g}</span>)}
    <span class="badge" data-src={profile.attrSrc}>Attributes {profile.attrSrc.toUpperCase()}</span>
    <span class="badge" data-src={profile.src}>Behaviour {profile.src.toUpperCase()}</span>
  </p>
  <p class="lead">{r.summary} <span class="tip-inline">{r.tip}</span></p>
  <RoleExplorer client:visible roleId={r.id} base={BASE} />
  <h2>Key attributes</h2>
  <ul class="attr-list">
    {r.keyAttrs.map((k) => <li><a data-key-attr href={href(`/attributes/${k}`)}>{ATTR_NAME[k]}</a></li>)}
    {r.prefAttrs.map((k) => <li><a href={href(`/attributes/${k}`)}>{ATTR_NAME[k]}</a></li>)}
  </ul>
  <div class="prose">
    <Content />
    <h2>How the simulation reads these attributes</h2>
    <AttrModel keys={[...r.keyAttrs, ...r.prefAttrs]} keyAttrs={r.keyAttrs} />
    {profile.note && <p><em>Tuning note:</em> {profile.note}</p>}
  </div>
</Base>
