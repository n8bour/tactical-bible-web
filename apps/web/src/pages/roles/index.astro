---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RoleFilter from '../../lab/RoleFilter';
import { GROUP_NAME, href, PHASE_NAME } from '../../lib/site';

const roles = (await getCollection('roles')).map((e) => e.data);
---
<Base title="Roles">
  <h1>Roles</h1>
  <p class="lead">Every player has one role with the ball (IP) and one without it (OOP). Pick a role to see it play.</p>
  <RoleFilter client:load groups={Object.entries(GROUP_NAME).map(([value, label]) => ({ value, label }))} />
  <ul class="role-list" id="role-list" role="list">
    {roles.map((r) => (
      <li data-role-item data-name={`${r.name} ${r.ab}`.toLowerCase()} data-groups={r.groups.join(' ')} data-phase={r.phase}>
        <a class="card" href={href(`/roles/${r.id}`)}>
          <h2>{r.name} <span class="badge" data-phase>{r.ab}</span></h2>
          <p>{PHASE_NAME[r.phase]} · {r.groups.map((g) => GROUP_NAME[g]).join(', ')}</p>
          <p>{r.summary}</p>
        </a>
      </li>
    ))}
  </ul>
  <div role="status" aria-live="polite">
    <p id="role-empty" hidden>No role matches these filters.</p>
  </div>
</Base>
