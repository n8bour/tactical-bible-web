---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CAT_NAME, href } from '../../lib/site';

const attrs = (await getCollection('attributes')).map((e) => e.data);
---
<Base title="Attributes">
  <h1>Attributes</h1>
  <p class="lead">Each page shows exactly how the simulation uses the attribute, generated from the model's code.</p>
  {(['T', 'M', 'F', 'G'] as const).map((cat) => (
    <section>
      <h2>{CAT_NAME[cat]}</h2>
      <ul class="cards" role="list">
        {attrs.filter((a) => a.cat === cat).map((a) => (
          <li><a class="card" href={href(`/attributes/${a.key}`)}><h3>{a.name}</h3><p>{a.summary}</p></a></li>
        ))}
      </ul>
    </section>
  ))}
</Base>
