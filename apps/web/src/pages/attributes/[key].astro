---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { attrUses, CAT_NAME, href, rolesUsing, RULE_LABEL } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('attributes');
  return entries.map((entry) => ({ params: { key: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
const a = entry.data;
const { Content } = await render(entry);
const [use] = attrUses([a.key]);
const roles = rolesUsing(a.key);
---
<Base title={a.name} description={a.summary}>
  <p><a href={href('/attributes')}>← Attributes</a></p>
  <h1>{a.name}</h1>
  <p><span class="badge" data-phase>{CAT_NAME[a.cat]}</span></p>
  <p class="lead">{a.summary}</p>
  <div class="prose"><Content /></div>
  <h2 id="attr-model-heading">How the simulation uses it</h2>
  {use.rules.length ? (
    <div tabindex="0" role="region" aria-labelledby="attr-model-heading" class="table-wrapper">
      <table class="model">
        <caption class="visually-hidden">Simulation rules using {a.name}</caption>
        <thead>
          <tr>
            <th scope="col">Behaviour</th>
            <th scope="col">Formula</th>
            <th scope="col">Unit</th>
            <th scope="col">Source</th>
            <th scope="col">Note</th>
          </tr>
        </thead>
        <tbody>
          {use.rules.map((r) => (
            <tr>
              <th scope="row">{RULE_LABEL[r.key as keyof typeof RULE_LABEL]}</th>
              <td><code>{r.formula}</code></td>
              <td>{r.unit}</td>
              <td><span class="badge" data-src={r.src}>{r.src.toUpperCase()}</span></td>
              <td>{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p>The simulation does not use this attribute yet.</p>
  )}
  <p>n(v) = (v − 1) / 19 maps an attribute from 1–20 onto 0–1.</p>
  {roles.length > 0 && (
    <>
      <h2>Roles that rely on it</h2>
      <ul class="attr-list" role="list">
        {roles.map((r) => <li><a data-key-attr={r.key.includes(a.key) ? '' : undefined} href={href(`/roles/${r.id}`)}>{r.name}</a></li>)}
      </ul>
    </>
  )}
</Base>
