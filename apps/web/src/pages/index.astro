---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
import { ROLES, teamInstructions, playerInstructions, concepts, attributes } from '@tb/content';

const sections = [
  { path: '/tactics', title: 'Tactics board', text: 'Pick your shapes, the opponent and every team instruction; watch your team attack and defend.' },
  { path: '/roles', title: 'Roles', text: `All ${ROLES.length} roles. Pick a position and role, then see him with and without the ball and how his attributes change it.` },
  { path: '/instructions', title: 'Instructions', text: `${teamInstructions.length} team and ${playerInstructions.length} player instructions, each with a before/after diagram.` },
  { path: '/concepts', title: 'Concepts', text: `${concepts.length} principles explained on the pitch: width, rest-defence, box occupation, pressing coherence and more.` },
  { path: '/attributes', title: 'Attributes', text: `How each of the ${attributes.length} attributes drives behaviour in the simulation.` },
  { path: '/lab', title: 'Sandbox', text: 'Free play: change anything on any player of either team while the match runs.' },
];
---
<Base title="FM27 Tactical Bible">
  <h1>FM27 Tactical Bible</h1>
  <p class="lead">
    Roles, instructions and tactical concepts for Football Manager 27, explained with a live 2D simulation.
    Change a player's attributes, role or instructions and watch what changes, for him and for the team.
  </p>
  <ul class="cards" role="list">
    {sections.map((s) => (
      <li><a class="card" href={href(s.path)}><h2>{s.title}</h2><p>{s.text}</p></a></li>
    ))}
  </ul>
</Base>
