---
// Renders a concept's board. Astro can only hydrate components it sees imported in the file, so the
// interactive boards are imported and switched on here; the registry says which keys those are.
import { BOARDS } from './index';
import BoxBoard from './boards/box';
import IpOopBoard from './boards/ip_oop';
import OutletsBoard from './boards/outlets';
import PressCohBoard from './boards/press_coh';
import RestDefBoard from './boards/rest_def';
import WidthBoard from './boards/width';

const { k } = Astro.props as { k: string };
const entry = BOARDS[k];
if (!entry) throw new Error(`No concept board registered for "${k}"`);
const Static = entry.interactive ? null : entry.Board;
---
{Static && <Static />}
{entry.interactive && k === 'ip_oop' && <IpOopBoard client:visible />}
{entry.interactive && k === 'rest_def' && <RestDefBoard client:visible />}
{entry.interactive && k === 'width' && <WidthBoard client:visible />}
{entry.interactive && k === 'box' && <BoxBoard client:visible />}
{entry.interactive && k === 'press_coh' && <PressCohBoard client:visible />}
{entry.interactive && k === 'outlets' && <OutletsBoard client:visible />}
