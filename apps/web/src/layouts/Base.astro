---
import { pwaInfo } from 'virtual:pwa-info';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Interactive FM27 guide to roles, instructions and tactical concepts, with a live pitch simulation.' } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['/tactics', 'Tactics board'],
  ['/roles', 'Roles'],
  ['/instructions', 'Instructions'],
  ['/concepts', 'Concepts'],
  ['/attributes', 'Attributes'],
  ['/lab', 'Sandbox'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'FM27 Tactical Bible' ? title : `${title} · FM27 Tactical Bible`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#14532d" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>FM27 Tactical Bible</a>
      <nav aria-label="Sections">
        {nav.map(([href, label]) => (
          <a href={`${base}${href}`} aria-current={path.startsWith(`${base}${href}`) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="disclaimer">
      A hand-tuned model of the FM match engine's intent, not the engine itself.
      <span class="badge" data-src="conf">CONF</span> = confirmed by public sources,
      <span class="badge" data-src="est">EST</span> = estimated.
    </footer>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </body>
</html>
